# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Gemini model to use (defaults to gemini-3.8-flash if empty)
GEMINI_MODEL=gemini-3.8-flash

# Model used for the one retry when the main model is busy (set to none to disable)
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Port the server listens on
PORT=3000

# Optional: password to open the app (recommended when the app is online).
# Leave empty for no password on your own computer.
APP_PASSWORD=

# Optional: where tests, PDFs and results are stored (default: ./data).
# On a host, point this at a persistent disk, e.g. /var/data
DATA_DIR=
